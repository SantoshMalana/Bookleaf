# Copy to server/.env (local dev) or set these in your host's dashboard. NEVER commit real values.

# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/bookleaf for a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
# Required in production: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Demo / reviewer convenience ───────────────────────────────────────
# Seed the dataset on boot if the database is empty.
AUTO_SEED=true
# Shows one-click demo logins on the sign-in page (turn OFF for a real deployment).
DEMO_MODE=true
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
# Optional: pin "today" for payout-date maths (YYYY-MM-DD). Blank = real clock.
REFERENCE_DATE=

# ── AI (server-side only; the browser never sees these) ───────────────
# anthropic | groq | openai | none. Leave blank to auto-detect from whichever key is set.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Groq (OpenAI-compatible API) running the open-weight gpt-oss-120b reasoning model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. "low" keeps the hidden reasoning (billed as output tokens) small.
GROQ_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Only used for the cost estimate on the admin "AI usage" page (USD per million tokens).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Hard daily ceiling on AI spend in USD (UTC day). When reached, the app uses rule-based triage and template drafts
# until tomorrow. 0 disables the cap.
AI_DAILY_BUDGET_USD=5
# Circuit breaker: open after N consecutive failures, retry after the cool-down.
AI_BREAKER_THRESHOLD=4
AI_BREAKER_COOLDOWN_MS=45000

LOG_LEVEL=info
